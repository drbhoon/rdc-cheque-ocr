# ─────────────────────────────────────────────────────────────────────────────
# RDC PDC Cheque Tracker — production environment (prod branch / Docker)
# Copy this file to .env and fill in every value, then: docker compose up -d --build
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local PostgreSQL (the rdc-postgres-db container) ─────────────────────────
POSTGRES_USER=pdc_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=rdc_cheque_ocr

# The app connects to the DB over the compose network — the HOST is the DB
# service name "rdc-postgres-db" (NOT localhost). Keep the user/password/db
# below identical to the three POSTGRES_* values above.
DATABASE_URL=postgresql://pdc_user:change_me_strong_password@rdc-postgres-db:5432/rdc_cheque_ocr

# ── Core app ─────────────────────────────────────────────────────────────────
# Flask session-signing secret — a long random string, e.g.  openssl rand -hex 32
SECRET_KEY=
# Anthropic API key used for cheque OCR — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── First administrator ──────────────────────────────────────────────────────
# Seeds the first HO_ADMIN login on first startup, only while the users table is
# empty. Afterwards, manage users in-app (👤 Users).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email reminders (Gmail / Google Workspace SMTP) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# A real, login-capable mailbox with 2-Step Verification + an App Password.
SMTP_USER=
SMTP_APP_PASSWORD=
# "From" address on reminder emails (usually the same as SMTP_USER).
SMTP_FROM=
# Central HO mailbox that receives the full daily reminder digest.
HO_REMINDER_EMAIL=

# ── Scheduler ────────────────────────────────────────────────────────────────
# Shared secret guarding the daily reminder trigger:
#   GET http://<host>:3001/cron/reminders?key=<CRON_SECRET>
CRON_SECRET=
